# ==========================================
# VAJRA Environment Configuration
# ==========================================

# Backend Configuration (Railway / Local)
PORT=8000
ENV=production
CORS_ORIGINS=*

# Frontend Configuration (Vercel / Local)
# Both naming formats (NEXT_... and NEXT_PUBLIC_...) are supported
NEXT_API_URL=http://localhost:8000
NEXT_MAPBOX_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJjbGV4YW1wbGUwMDAwMDAwMDB4YW1wbGUifQ.example

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJjbGV4YW1wbGUwMDAwMDAwMDB4YW1wbGUifQ.example

# Meteorological & Satellite Data Sources (Optional / Advanced)
CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
CDSAPI_KEY=your_copernicus_cds_key_here
DATABASE_URL=postgresql://vajra_user:vajra_pass@localhost:5432/vajra_db
